# ── Thuso · environment ──────────────────────────────────────────────────────
# Everything is optional. With nothing set, the agents run on their built-in
# playbook, the learner records are the sandbox LMS, and emails appear in the
# Inbox tab. Each value below switches one layer to live. Restart after editing.

# AI. The first key found wins: Anthropic, then OpenAI.
# The default model is Claude Haiku 5.5 (fast and cheap); set ANTHROPIC_MODEL
# to claude-sonnet-5-5 or claude-opus-5-5 for richer lessons and messages.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Real email through SMTP (Nodemailer). Gmail: smtp.gmail.com, 465, your Gmail
# address and an App Password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Thuso - Student Success"
# Musa emails the head of school a report every day at 17:00 (and on request).
MANAGER_EMAIL=
# Optional: send every email to one inbox instead of each learner's address.
DEMO_RECIPIENT_EMAIL=

# Where the quiz links in emails point. Use your laptop's network address
# (http://192.168.x.x:3200) or a tunnel URL so phones can open them.
PUBLIC_BASE_URL=http://localhost:3200

# The follow-up call: the academy's dialer and an API key with the
# "Start AI calls" scope (dialer → Settings → Developers → API keys).
DIALER_URL=
DIALER_API_KEY=

# Sending lock. While testing, nothing leaves the building: no email,
# WhatsApp, calls or write-backs, whatever the Live Outreach switch says.
# Messages are still drafted, reviewed and shown in the Inbox.
# Set to false only when you are ready to go live.
SENDING_PAUSED=true

# Security (set both in production).
# SESSION_SECRET signs staff sign-in cookies: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, a secret is generated in .data/ and sign-ins end on redeploy.
SESSION_SECRET=
# Optional: the default workspace's LMS webhook signing secret (HMAC-SHA256).
# Leave empty to have one generated; it is shown in Channels & API.
LMS_WEBHOOK_SECRET=
# Set to false to stop strangers registering new workspaces on this server.
ALLOW_SIGNUPS=true

# A real LMS API (optional). Leave empty to use the sandbox learner records.
# Moodle Web Services (optional — takes priority when both are set).
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_COURSE_IDS=
LMS_API_URL=
LMS_API_KEY=

# A Google Sheet as the learner record (optional; can also be set in Settings).
GOOGLE_SHEET_URL=

# PostgreSQL database for permanent student memory, workflows & follow-ups.
# Example for local Windows VPS Postgres database named "student-success":
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student-success
# Write-back: the Apps Script web app URL from the README.
SHEET_WRITEBACK_URL=

# Lesson voice: Deepgram (Aura) reads each learner's personal video lesson.
# Use the same Deepgram key as the dialer. Audio is made once per slide and
# cached in .data/media/. Without a key the lesson still plays with the
# browser's own voice. The narration greets the learner by first name and
# mentions their score, so that text is sent to Deepgram.
DEEPGRAM_API_KEY=
# The voice (any Deepgram Aura model, e.g. aura-2-thalia-en, aura-2-andromeda-en, aura-2-apollo-en):
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Optional alternatives, used only when there is no Deepgram key
# (or set TTS_PROVIDER=elevenlabs|openai to choose one):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# Lead nurturing: campaign messages sent per 5-second tick (keeps a big list from flooding the mail server).
# CAMPAIGN_PER_TICK=6

# Reading replies (Lead Nurturing → Journey → Replies). Defaults to the SMTP account
# (smtp.gmail.com → imap.gmail.com, same app password). Set these only for a different mailbox.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# REPLIES_PER_PERSON_PER_DAY=4
